{
  "name": "@roypadina/claude-jam",
  "version": "0.24.4",
  "description": "Share one real Claude Code session with other humans, live over WebSockets",
  "license": "MIT",
  "author": "Roy Padina",
  "repository": "github:roypadina/claude-jam",
  "type": "module",
  "bin": {
    "claude-jam": "cli.mjs",
    "jam": "cli.mjs"
  },
  "files": [
    "claude-jam",
    "jam",
    "*.mjs",
    "!test.mjs",
    "hooks.sh",
    "MANUAL.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test.mjs",
    "prepublishOnly": "node --test test.mjs"
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "ink": "^5.2.1",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1",
    "ws": "^8.21.3"
  },
  "homepage": "https://github.com/roypadina/claude-jam/wiki",
  "bugs": "https://github.com/roypadina/claude-jam/issues",
  "keywords": [
    "claude-code",
    "claude",
    "tmux",
    "collaboration",
    "pair-programming",
    "websocket",
    "multiplayer",
    "terminal",
    "ai-agents",
    "shared-session"
  ],
  "publishConfig": {
    "access": "public"
  }
}
