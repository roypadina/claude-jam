#!/bin/bash
# claude-jam launcher.  claude-jam host [...]  |  claude-jam join <invite-link | ws-url --name X>
#                       claude-jam sessions|ls |  claude-jam end|kill [name]  |  claude-jam clean
#                       claude-jam invite <Name> | claude-jam invites | claude-jam invite revoke <Name|id>
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  echo "usage: claude-jam                  (no arguments) the launcher menu: host, join,"
  echo "                                   my jams, end a jam. --no-menu prints this instead."
  echo "usage: claude-jam host [--port N] [--name X] [--cwd DIR] [--tmux NAME] [--token V]"
  echo "                [--invite-only] [--jam-name X] [--no-announce] [--view]"
  echo "                [--tunnel] [--funnel]"
  echo "                [--config-dir D] [--tmux-socket default] [--no-sound]"
  echo "                [--uploads ask|auto|off] [--upload-quota N[MB|files]]"
  echo "                [--export ask|auto|off] [--replay N|all] [--history N]"
  echo "                [--no-system-prompt] [--answers host|anyone] [--peer-tasks]"
  echo "                [--resume ID] [-- <claude args>]"
  echo "         --jam-name is what the jam is CALLED (default: this directory's name); it"
  echo "         shows in the welcome, in claude-jam sessions and to anyone on this network."
  echo "         --no-announce keeps it off the network — it is announced by default."
  echo "         --invite-only refuses knocking altogether: an invite link is the only door,"
  echo "         and every link is name-bound, expiring and revocable one at a time."
  echo "         --tunnel and --funnel are the two public relays for the same port — pick one."
  echo "         --tunnel is a cloudflared quick tunnel (a new URL each restart); --funnel is"
  echo "         Tailscale Funnel (a stable URL, and it needs Funnel enabled on your tailnet)."
  echo "         builds a detached tmux session (daemon + the real claude TUI) on claude-jam's own"
  echo "         tmux server and opens your client here: live TUI by default, F2 transcript,"
  echo "         F3 attaches the real TUI (F3 again, or Ctrl-b d, comes back)."
  echo "         anyone may /answer a question claude asks (--answers host keeps that to you);"
  echo "         permission prompts are always yours to approve."
  echo "         --uploads decides whether the host is asked about every file a guest sends;"
  echo "         --export is separate and stays ask, because a transcript is the WHOLE"
  echo "         conversation. Neither one relaxes the 20 MB cap, the jam-uploads/"
  echo "         confinement or the traversal refusal. --no-sound starts your client silent."
  echo "         --history is how many events the jam keeps (default 2000, cap 20000) for"
  echo "         replay and for /history; --replay is how much of that a joining guest is"
  echo "         shown (default 300, or all). PgUp in the live TUI scrolls the host's real"
  echo "         pane history; /export is always the complete record."
  echo "         --peer-tasks lets YOUR claude hand work to a GUEST's own Claude Code. It is off"
  echo "         unless you pass it, and even then nothing can be dispatched to anybody until"
  echo "         that guest types /peer on and approves each individual task. The task runs on"
  echo "         THEIR machine, on THEIR account and quota; no credential crosses the wire."
  echo "         --resume ID continues an existing claude conversation instead of starting one."
  echo "         on exit it asks whether to keep the jam running or end it"
  echo "         ([--no-prompt] [--end-on-exit] [--keep-on-exit] decide it up front)."
  echo "       claude-jam host --attach [--tmux NAME]"
  echo "         reopen your client on a jam that is already running."
  echo "       claude-jam adopt [--pane %23] [--socket NAME] [--yes] [--no-brief]"
  echo "                        [--brief-updates on|off] [<any claude-jam host flag>]"
  echo "         share the claude you are ALREADY in, without restarting it. Run it from"
  echo "         inside that session (claude can run it for you) or point --pane at one."
  echo "         It shows what it resolved — pane, socket, directory, session id, and that"
  echo "         session's first and last line — and asks before sharing anything; --yes"
  echo "         skips the question. claude-jam never ends a session it did not start:"
  echo "         claude-jam end stops the daemon and leaves the pane and claude alone."
  echo "         At adoption claude is TOLD it is now shared (--no-brief skips that)."
  echo "       claude-jam join <invite-link>"
  echo "         one command, nothing else: the link carries the address, your name and a"
  echo "         per-invite secret, so there is no approval to wait for."
  echo "       claude-jam join"
  echo "         no argument at all: pick from the jams on this network, or paste a link."
  echo "       claude-jam join <ws-url> --name X [--token Y] [--basic] [--no-sound]"
  echo "         no token = knock, the host accepts you."
  echo "       claude-jam invite <Name> [--uses N] [--expires 24h] [--jam NAME]"
  echo "         mint a link for one person. claude-jam invites lists them,"
  echo "         claude-jam invite revoke <Name|id> takes one back."
  echo "         A link is a password — send it privately."
  echo "       claude-jam find [--json] | claude-jam discover"
  echo "         jams announcing themselves on this network: name, host, how to get in,"
  echo "         address. Finding one is not being let in — you still knock, or hold a"
  echo "         token, or hold an invite link."
  echo "       claude-jam sessions [--json] | claude-jam ls"
  echo "         claude-jam's own tmux sessions and state dirs: port, cwd, uptime, who is here."
  echo "       claude-jam end [name] [--all] | claude-jam kill [name]"
  echo "         end one jam: everyone is told, then the tmux session and its state dir go."
  echo "       claude-jam clean [--yes]"
  echo "         remove state dirs whose session is gone. Never touches a live one."
  echo "       claude-jam remote <off|tunnel|funnel> [--jam NAME]"
  echo "         put a running jam on a public relay, or take it back off. Same thing"
  echo "         /menu -> Access -> Remote does, over the loopback control endpoint."
  exit "${1:-2}"
}

# v0.22A: no arguments at all is the launcher menu. ANY argument (including --no-menu) means the
# caller already knows what they want, so nothing below this line changes.
if [ "$#" -eq 0 ]; then exec node "$DIR/menu.mjs"; fi

cmd="${1:-}"; shift || true
case "$cmd" in
  host) exec node "$DIR/host.mjs" "$@" ;;
  # v0.33: share the session already running in a tmux pane. It resolves and CONFIRMS before it
  # touches anything, then hands host.mjs a plan — so there is still exactly one daemon launcher.
  adopt) exec node "$DIR/sessions.mjs" adopt "$@" ;;
  # v0.23: `claude-jam join` with nothing after it is a question, not a mistake — the launcher
  # menu opens on its Join screen, which starts with the jams it can see on this network.
  join) if [ "$#" -eq 0 ]; then exec node "$DIR/menu.mjs" join; fi; exec node "$DIR/client.mjs" "$@" ;;
  # v0.18: jam owns the tmux sessions it made. `sessions` lists only those, `end` ends one
  # (marker-verified, exact name), `clean` removes orphan/incomplete state dirs and nothing else.
  sessions|ls) exec node "$DIR/sessions.mjs" list "$@" ;;
  # v0.23: who else is on this network. Talks to no daemon and holds no credential.
  find|discover) exec node "$DIR/sessions.mjs" find "$@" ;;
  end|kill) exec node "$DIR/sessions.mjs" end "$@" ;;
  clean) exec node "$DIR/sessions.mjs" clean "$@" ;;
  # v0.22B: invite links, from the command line as well as from `/invite` in the client.
  invite) exec node "$DIR/sessions.mjs" invite "$@" ;;
  invites) exec node "$DIR/sessions.mjs" invites "$@" ;;
  # v0.24.1: the relay switch from a shell — the same daemon path /menu drives.
  remote) exec node "$DIR/sessions.mjs" remote "$@" ;;
  # v0.22A: the menu is what a bare `claude-jam` runs; --no-menu asks for the usage instead.
  --no-menu) usage 0 ;;
  # -h/--help/help is a question, not a mistake: the same text, exit 0, and never a jam.
  -h|--help|help) usage 0 ;;
  *) usage 2 ;;
esac
