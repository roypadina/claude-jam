#!/bin/bash
# claude-jam launcher.  jam host [...]  |  jam join <ws-url> --name X --token Y
#                       jam sessions|ls |  jam end|kill [name]  |  jam clean
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  echo "usage: jam host [--port N] [--name X] [--cwd DIR] [--tmux NAME] [--token V]"
  echo "                [--view] [--tunnel] [--config-dir D] [-- <claude args>]"
  echo "         builds a detached tmux session (daemon + the real claude TUI) and opens"
  echo "         your own client here: live TUI by default, F2 transcript, F3 TUI control."
  echo "         on exit it asks whether to keep the jam running or end it"
  echo "         ([--no-prompt] [--end-on-exit] [--keep-on-exit] decide it up front)."
  echo "       jam host --attach [--tmux NAME]"
  echo "         reopen your client on a jam that is already running."
  echo "       jam join <invite-link>"
  echo "         one command, nothing else: the link carries the address, your name and a"
  echo "         per-invite secret, so there is no approval to wait for."
  echo "       jam join <ws-url> --name X [--token Y] [--basic]"
  echo "         no token = knock, the host accepts you."
  echo "       jam invite <Name> [--uses N] [--expires 24h] [--jam NAME]"
  echo "         mint a link for one person. jam invites lists them, jam invite revoke <Name|id>"
  echo "         takes one back. A link is a password — send it privately."
  echo "       jam sessions [--json] | jam ls"
  echo "         jam's own tmux sessions and state dirs: port, cwd, uptime, who is here."
  echo "       jam end [name] [--all] | jam kill [name]"
  echo "         end one jam: everyone is told, then the tmux session and its state dir go."
  echo "       jam clean [--yes]"
  echo "         remove state dirs whose session is gone. Never touches a live one."
  exit "${1:-2}"
}

cmd="${1:-}"; shift || true
case "$cmd" in
  host) exec node "$DIR/host.mjs" "$@" ;;
  join) exec node "$DIR/client.mjs" "$@" ;;
  # v0.18: jam owns the tmux sessions it made. `sessions` lists only those, `end` ends one
  # (marker-verified, exact name), `clean` removes orphan state dirs and nothing else.
  sessions|ls) exec node "$DIR/sessions.mjs" list "$@" ;;
  end|kill) exec node "$DIR/sessions.mjs" end "$@" ;;
  clean) exec node "$DIR/sessions.mjs" clean "$@" ;;
  # v0.22B: invite links, from the command line as well as from `/invite` in the client.
  invite) exec node "$DIR/sessions.mjs" invite "$@" ;;
  invites) exec node "$DIR/sessions.mjs" invites "$@" ;;
  # -h/--help/help is a question, not a mistake: the same text, exit 0, and never a jam.
  -h|--help|help) usage 0 ;;
  *) usage 2 ;;
esac
